<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Gurio.SkinChanger</AssemblyName>
    <RootNamespace>STS2SkinChanger</RootNamespace>
    <!-- Internal test marker. Keep SkinChanger.json's three-part public version for the game's
         SemanticVersion parser; the four-part marker is emitted by Entry at startup. -->
    <Version>0.9.122.7</Version>
    <AssemblyVersion>0.9.122.7</AssemblyVersion>
    <FileVersion>0.9.122.7</FileVersion>
    <InformationalVersion>0.9.122.7</InformationalVersion>
    <!-- Keep the managed Mod architecture-neutral so the same Workshop DLL loads in both
         Windows x64 and macOS Apple Silicon game processes. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The installed main branch is the depot copy below. The public beta remains available by
         passing -p:GameAssemblyDir explicitly, so a normal build cannot silently target v0.111.0
         when the player is testing the v0.107.1 release. -->
    <GameAssemblyDir Condition="'$(GameAssemblyDir)' == ''">/mnt/d/Programs/Steam/steamapps/content/app_2868840/depot_2868841/data_sts2_windows_x86_64</GameAssemblyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameAssemblyDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameAssemblyDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameAssemblyDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(GameAssemblyDir)/Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
