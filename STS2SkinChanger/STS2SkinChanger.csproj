<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Gurio.SkinChanger</AssemblyName>
    <RootNamespace>STS2SkinChanger</RootNamespace>
    <!-- Internal test marker. Keep SkinChanger.json's three-part public version for the game's
         SemanticVersion parser; the four-part marker is emitted by Entry at startup. -->
    <Version>0.10.3.3</Version>
    <AssemblyVersion>0.10.3.3</AssemblyVersion>
    <FileVersion>0.10.3.3</FileVersion>
    <InformationalVersion>0.10.3.3</InformationalVersion>
    <!-- Keep the managed Mod architecture-neutral so the same Workshop DLL loads in both
         Windows x64 and macOS Apple Silicon game processes. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../compat/ThunninoiSkinManagerCompat/ThunninoiSkinManagerCompat.csproj"
                      ReferenceOutputAssembly="false" />
    <Reference Include="sts2">
      <HintPath>$(GameAssemblyDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameAssemblyDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameAssemblyDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(GameAssemblyDir)/Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyBundledSkinFrameworkCompatibility" AfterTargets="Build">
    <Copy SourceFiles="../compat/ThunninoiSkinManagerCompat/bin/$(Configuration)/net9.0/thunninoiSkinManager.dll"
          DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
