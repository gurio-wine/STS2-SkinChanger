<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A separate process intentionally has NO reference to the bundled same-name DLL. -->
    <ProjectReference Include="../../STS2SkinChanger/STS2SkinChanger.csproj" />
    <Reference Include="sts2"><HintPath>$(GameAssemblyDir)/sts2.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameAssemblyDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameAssemblyDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="Steamworks.NET"><HintPath>$(GameAssemblyDir)/Steamworks.NET.dll</HintPath></Reference>
  </ItemGroup>
</Project>
