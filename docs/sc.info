// ================================================================
//  sc.info —— Skin Changer 外部来源识别文件
//  sc.info —— identification file for Skin Changer (GitHub-sourced Mods)
// ----------------------------------------------------------------
//  用途 / What it is:
//    Mod 发在 GitHub 时，把本文件放在仓库根目录（文件名就叫 sc.info），
//    Skin Changer 就能直接认出它是什么皮肤、包含哪些内容，不用下载扫描。
//    Place this file at your repository root (name it exactly "sc.info") and
//    Skin Changer recognizes what the Mod contains without downloading it.
//
//  说明 / Rules:
//    · 纯文本，不加密、不校验哈希；改成你自己的内容后直接提交。
//      Plain text. No encryption, no checksum. Edit and commit.
//    · 文件里的注释（// 开头）可以保留，也可以删掉。
//      Comments (lines starting with //) may stay or be deleted.
//    · 下面带中文说明的字段是真的示例值，发给别人前请整段替换。
//      The values below are real examples — replace them with your own.
//    · 不认识的多余字段会被忽略，你可以自己加备注。
//      Unknown extra fields are ignored; add your own notes freely.
// ================================================================
{
  // 文件版本，固定 1，不要改 / format version, always 1
  "sc": 1,

  // 显示名称（必填）。列表里显示的就是这个名字，中英日韩都可以。
  // Display name (required). Shown in the Mod list; any language.
  "name": "示例：铁甲战士 暗影皮肤",

  // 这个 Mod 同时还发在 Steam 创意工坊时，填数字工坊 ID；只在 GitHub 发布就留 0。
  // Workshop item ID if this Mod is also on Steam; 0 if GitHub only.
  "workshopId": 0,

  // 这个 Mod 会替换什么（必填，至少一项；可以多项）。
  // What this Mod replaces (required, one or more entries).
  // kind / target 的取值见文件末尾。
  "targets": [
    { "kind": "character", "target": "ironclad" },
    { "kind": "cards", "target": "ironclad" }
  ],

  // 玩家必须重启游戏才能生效吗？true / false
  // Does the player have to restart the game for this Mod to work?
  "restartRequired": true,

  // 可选：适配的游戏版本，例如 "0.107.1"；不确定就留空字符串。
  // Optional: game version this Mod targets, e.g. "0.107.1"; "" if unsure.
  "gameVersion": "",

  // 可选：仓库里的预览图路径，例如 "preview.png"；没有就留空。
  // Optional: preview image path inside your repository; "" if none.
  "cover": ""
}

